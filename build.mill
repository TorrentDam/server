//| mill-version: 1.1.8
//| mill-jvm-version: temurin:21.0.6
import mill.*, scalalib.*, publish.*

object protocol extends CommonSettings {
  def mvnDeps = Seq(
    Deps.bittorrent.common,
    Deps.upickle,
    Deps.`scodec-bits`,
  )
}

object server extends CommonSettings {
  def moduleDeps = Seq(protocol)
  def mvnDeps = Seq(
    Deps.bittorrent.bittorrent,
    Deps.bittorrent.dht,
    Deps.`cats-effect`,
    Deps.`fs2-io`,
    Deps.http4s.core,
    Deps.http4s.dsl,
    Deps.http4s.server,
    Deps.http4s.client,
    Deps.`woof-core`,
    Deps.`woof-slf4j`,
    Deps.`cats-effect-cps`,
  )
}

trait CommonSettings extends ScalaModule, PublishModule {
  def scalaVersion = "3.8.3"
  def scalacOptions = Seq(
    "-source:future",
    "-Xkind-projector:underscores",
  )
  def sources = Task.Sources(
    moduleDir / "src" / "main" / "scala"
  )
  def resources = Task.Sources(
    moduleDir / "src" / "main" / "resources"
  )
  def publishVersion = sys.env.getOrElse("VERSION", "SNAPSHOT")
  def pomSettings = PomSettings(
    description = "Bittorrent server protocol",
    organization = "io.github.torrentdam.server",
    url = "https://github.com/TorrentDam/server",
    licenses = Seq(License.`Unlicense`),
    versionControl = VersionControl.github("TorrentDam", "server"),
    developers = Seq(
      Developer("lavrov", "Vitaly Lavrov", "https://github.com/lavrov")
    )
  )
}

object Deps {
  object Versions {
    val bittorrent = "3.8.0"
    val `cats-effect` = "3.6.0"
    val fs2 = "3.12.2"
    val `scodec-bits` = "1.2.4"
    val upickle = "2.0.0"
    val http4s = "1.0.0-M40"
    val `cats-effect-cps` = "0.9.21"
    val woof = "0.9.0"
  }
  object bittorrent {
    private val org = "io.github.torrentdam.bittorrent"
    val common = mvn"${org}::common::${Versions.bittorrent}"
    val bittorrent = mvn"${org}::bittorrent::${Versions.bittorrent}"
    val dht = mvn"${org}::dht::${Versions.bittorrent}"
  }
  val `cats-effect` = mvn"org.typelevel::cats-effect::${Versions.`cats-effect`}"
  val `fs2-io` = mvn"co.fs2::fs2-io::${Versions.fs2}"
  val `scodec-bits` = mvn"org.scodec::scodec-bits::${Versions.`scodec-bits`}"
  val upickle = mvn"com.lihaoyi::upickle::${Versions.upickle}"
  object http4s {
    val core = mvn"org.http4s::http4s-core::${Versions.http4s}"
    val dsl = mvn"org.http4s::http4s-dsl::${Versions.http4s}"
    val server = mvn"org.http4s::http4s-ember-server::${Versions.http4s}"
    val client = mvn"org.http4s::http4s-ember-client::${Versions.http4s}"
  }
  val `cats-effect-cps` = mvn"com.github.rssh::cps-async-connect-cats-effect::${Versions.`cats-effect-cps`}"
  val `woof-core` = mvn"org.legogroup::woof-core::${Versions.woof}"
  val `woof-slf4j` = mvn"org.legogroup::woof-slf4j::${Versions.woof}"
}
